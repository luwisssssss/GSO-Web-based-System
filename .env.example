# Application
GSO_APP_ENV=production
GSO_APP_DEBUG=0
GSO_APP_URL=https://your-gso-host.example/GSO_WebSystem
GSO_APP_TIMEZONE=Asia/Manila

# Secret used to key one-way identifiers (login throttling). Keep it out of
# version control and out of the database. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# If left blank the app generates and caches one in config/app_key.local.php.
GSO_APP_KEY=
GSO_RUN_MIGRATIONS=0
GSO_SESSION_SECURE=1
GSO_SESSION_SAMESITE=Lax
GSO_SESSION_IDLE_TIMEOUT=1800
GSO_SESSION_ABSOLUTE_TIMEOUT=28800
# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
GSO_TRUST_PROXY_HEADERS=0

# Private storage outside the web document root
GSO_INCIDENT_PHOTO_DIR=C:/xampp/private/GSO_WebSystem/incident_photos
GSO_MAIL_OUTBOX_DIR=C:/xampp/private/GSO_WebSystem/mail_outbox

# Development only: also requires a non-production environment and loopback request.
GSO_ALLOW_LOCAL_MAIL_FALLBACK=0

# Database
GSO_DB_HOST=localhost
GSO_DB_PORT=3306
GSO_DB_NAME=gso_database
GSO_DB_USERNAME=gso_app
GSO_DB_PASSWORD=replace-with-a-strong-random-password

# SMTP
# Use a Gmail App Password, not your normal Gmail password.
GSO_SMTP_HOST=smtp.gmail.com
GSO_SMTP_PORT=587
GSO_SMTP_SECURE=tls
GSO_SMTP_USERNAME=your-gmail-address@gmail.com
GSO_SMTP_PASSWORD=replace-with-a-provider-app-password
GSO_SMTP_FROM=your-gmail-address@gmail.com
GSO_SMTP_FROM_NAME=GSO Management System

# --- AI chatbot (Step 9) ------------------------------------------------
# AI_PROVIDER selects the adapter: deepseek, or leave blank/none to run the
# assistant on knowledge-base answers only. The key is server-side only and
# is never sent to the browser or written to logs.
AI_ENABLED=true
AI_PROVIDER=deepseek
AI_API_KEY=replace-with-your-provider-api-key
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=600
