# Application
GSO_APP_ENV=production
GSO_APP_DEBUG=0
GSO_APP_URL=http://localhost/GSO_WebSystem
GSO_APP_TIMEZONE=Asia/Manila

# Database
GSO_DB_HOST=localhost
GSO_DB_PORT=3306
GSO_DB_NAME=gso_database
GSO_DB_USERNAME=root
GSO_DB_PASSWORD=

# SMTP
# Use a Gmail App Password, not your normal Gmail password.
GSO_SMTP_HOST=smtp.gmail.com
GSO_SMTP_PORT=587
GSO_SMTP_SECURE=tls
GSO_SMTP_USERNAME=your-gmail-address@gmail.com
GSO_SMTP_PASSWORD=your16charapppassword
GSO_SMTP_FROM=your-gmail-address@gmail.com
GSO_SMTP_FROM_NAME=GSO Management System
